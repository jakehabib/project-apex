{
  "name": "project-apex",
  "productName": "Project Apex",
  "version": "0.0.1",
  "private": true,
  "description": "Project Apex — tactical-shooter esports management simulator (working title)",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test e2e/app.spec.ts",
    "sim:determinism": "node scripts/sim-determinism.mjs",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win dir --x64",
    "package:linux": "npm run build && electron-builder --linux dir --x64",
    "test:packaged": "playwright test e2e/packaged.spec.ts"
  },
  "build": {
    "appId": "com.projectapex.game",
    "productName": "Project Apex",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "dist-electron/*.cjs",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "dir"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.8",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "esbuild": "0.28.2",
    "pixi.js": "8.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "author": "Project Apex"
}
